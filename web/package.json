{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "inventaire-cloud-web",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . && prettier --check \"**/*.{js,css,json}\"",
