        "eslint-plugin-jsdoc": "^65.3.2",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "vite": "^8.0.0",
        "vitest": "^4.1.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.17.4",
        "@fontsource-variable/inter": "^5.3.0",
        "@tabler/core": "^1.6.1",
        "barcode-detector": "3.2.2",
        "zxing-wasm": "3.1.3"
