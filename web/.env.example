APP_NAME="inventaire.cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Display timezone only: dates are always stored in UTC.
APP_TIMEZONE=UTC

# Reverse proxies whose X-Forwarded-For header is believed: a comma-separated list of
# addresses or CIDR ranges, or * for any proxy. Empty (default) trusts none. Set it behind a
# reverse proxy or load balancer, otherwise every visitor looks like the proxy.
TRUSTED_PROXIES=

# Whether search engines may index the public pages (the home page and the templates). Off by
# default: /robots.txt disallows everything, every page carries noindex and /sitemap.xml is a
# 404. On a public instance set it to true, and set APP_URL to the public address (see the README).
APP_INDEXABLE=false

# Other hosts the web front is reached on (see the README, "Stateful requests (Sanctum)").
# SANCTUM_STATEFUL_DOMAINS=

# API tokens (the Account page): what they start with, the requests a token may make in a minute and the tokens a person may have.
# SANCTUM_TOKEN_PREFIX=inv_
# API_TOKEN_REQUESTS_PER_MINUTE=120
# MAX_API_TOKENS=20

# Where this instance's source code is published (AGPL-3.0 section 13). Forks
# must point it at their own repository; the footer links to it.
APP_REPOSITORY_URL=https://github.com/enzomerand/inventaire.cloud

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Services from compose.dev.yaml, reachable from this machine only. The password
# below is a local-only development default: never reuse it anywhere else. The
# test suite uses the separate `inventaire_test` database (see composer test).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=inventaire
DB_USERNAME=inventaire
DB_PASSWORD=secret

# MySQL alternative:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=33069

# MariaDB alternative (same credentials as above):
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=33070

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies over plain http, local setups only (see the README, "Behind a reverse proxy").
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk the files attached to items are written to: a private one ("local", "s3"...), never "public". The default disk when empty.
# ATTACHMENTS_DISK=
QUEUE_CONNECTION=database
# Exports (spreadsheet, CSV, JSON, PDF, zip of the photos): written by the queue worker, kept for a few hours, then purged.
# INVENTORIES_EXPORTS_PER_MINUTE=10
# INVENTORIES_MAX_ACTIVE_EXPORTS=10
# INVENTORIES_EXPORT_STORAGE_PER_USER=2048
# INVENTORIES_EXPORT_TTL_HOURS=24
# INVENTORIES_PDF_MAX_ITEMS=500
# INVENTORIES_EXPORT_STALE_MINUTES=60
# Imports (CSV, TSV, TXT, XLSX, ODS into an inventory): converted and written by the same queue worker as the exports, the file deleted as soon as it ends.
# INVENTORIES_IMPORTS_PER_MINUTE=10
# INVENTORIES_MAX_ACTIVE_IMPORTS=3
# INVENTORIES_IMPORT_MAX_SIZE_MB=10
# INVENTORIES_IMPORT_MAX_ROWS=10000
# INVENTORIES_IMPORT_MAX_COLUMNS=200
# INVENTORIES_IMPORT_MAX_UNPACKED_SIZE_MB=100
# INVENTORIES_IMPORT_TTL_HOURS=24
# INVENTORIES_IMPORT_STALE_MINUTES=60

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit from compose.dev.yaml (web UI on http://localhost:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@inventaire.cloud"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Custom endpoint of an S3-compatible service (MinIO, Scaleway, OVH...); empty for AWS.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documenso e-signature (optional): instance URL, team API token and the secret Documenso sends in the
# X-Documenso-Secret header of its webhook (POST /webhooks/documenso).
DOCUMENSO_URL=
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=

# First administrator, created by the installation (`composer setup`, `inventaire:install --from-env`). There
# are no passwords: they sign in with a code sent to this address (the Mailpit inbox in development).
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@example.com

VITE_APP_NAME="${APP_NAME}"
