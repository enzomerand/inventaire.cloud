<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- APP_ENV=testing makes Laravel load .env.testing (empty) instead of the real .env: see that file. -->
        <env name="APP_ENV" value="testing"/>
        <!-- A throw-away key that protects nothing: the real one lives in the developer's .env, which tests never read. -->
        <env name="APP_KEY" value="base64:vYU7ee1XHOuhWH078v6IvJEB9zvu7Qj9bc6kCUVXhKs="/>
        <env name="APP_LOCALE" value="fr"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Everything the installer writes lives in one throw-away folder (see Tests\Support\InstallerSandbox). -->
        <env name="INSTALLER_STATE_PATH" value="storage/framework/testing/installer/state"/>
        <env name="INSTALLER_ENV_FILE" value="storage/framework/testing/installer/.env"/>
        <env name="APP_CONFIG_CACHE" value="storage/framework/testing/installer/config.php"/>
        <env name="CACHE_FILE_PATH" value="storage/framework/testing/installer/cache"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="54329"/>
        <env name="DB_DATABASE" value="inventaire_test"/>
        <env name="DB_USERNAME" value="inventaire"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
