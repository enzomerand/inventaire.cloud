# Configuration of the Docker setup. Copy this file to `.env` (in this folder; it is
# ignored by git) and edit it. Docker Compose reads it for its own substitutions and
# hands everything in it to the containers as real environment variables.
#
# There are two ways to configure an instance. Pick one.

# -----------------------------------------------------------------------------
# 1. Wizard (the minimum): set the database password and open the application.
#    The install wizard at /install asks for everything else (public URL, language,
#    email, file storage...). It needs a one-time setup token:
#      docker compose exec app php artisan inventaire:install-token
# -----------------------------------------------------------------------------

# Password of the database the compose file creates. Choose a long random one, and note
# that it is only applied when the database is first created.
DB_PASSWORD=

# Port published on the host (the container always listens on 8080).
# APP_PORT=8080

# Behind a reverse proxy: its address(es) or CIDR range(s), comma-separated, or * for
# any proxy. Without it every visitor looks like the proxy (see the README).
# TRUSTED_PROXIES=

# Whether search engines may index the public pages (the home page and the templates). Off by
# default: /robots.txt disallows everything, every page carries noindex and /sitemap.xml is a
# 404. On a public instance set it to true, and set APP_URL to the public address (see the README).
# APP_INDEXABLE=false

# Secure cookies over plain http, local setups only (see the README, "Behind a reverse proxy").
# SESSION_SECURE_COOKIE=false

# Other hosts the application is reached on (see the README, "Stateful requests (Sanctum)").
# SANCTUM_STATEFUL_DOMAINS=

# -----------------------------------------------------------------------------
# 2. Everything in this file: no wizard. When every setting below is present, the
#    instance installs itself the first time the app container starts (it checks the
#    database, the mail server and the storage for real, and stops with the reason
#    if one fails). Each variable you set here is shown read-only in the wizard.
#    Uncomment and fill in all of them (the administrator included).
# -----------------------------------------------------------------------------

# Public URL of the instance, language (fr or en) and display timezone. Dates are always stored in
# UTC: the timezone is only used to display them (pages show dates in the browser's timezone).
# APP_URL=https://inventory.example.com
# APP_LOCALE=fr
# APP_TIMEZONE=Europe/Paris

# Outgoing email (SMTP). MAIL_SCHEME is smtp (STARTTLS when offered) or smtps (implicit TLS);
# leave MAIL_USERNAME and MAIL_PASSWORD out for a server without authentication.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="My Company"

# File storage: local (the storage volume) or an S3-compatible service.
# FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional e-signature (Documenso).
# DOCUMENSO_URL=
# DOCUMENSO_API_KEY=
# DOCUMENSO_WEBHOOK_SECRET=

# Optional photo entry (AI): Claude (Anthropic) reads photos of an object and proposes the values of its fields.
# It needs this key and the switch in Administration > Settings; see "Photo entry (AI)" in the README.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low
# Seconds a request to Claude may take, held between 10 and 120 whatever is set (the analysis job is killed after 300 seconds).
# ANTHROPIC_TIMEOUT=90
# Whether the models that accept it are sent the server-side fallback (a dated beta header); false stops it, the model stays.
# ANTHROPIC_FALLBACKS=true
# Analyses one person may ask for in a day, and the whole instance in a day (0 = no cap): the key is billed for every one.
# INVENTORIES_PHOTO_ANALYSES_PER_DAY=20
# INVENTORIES_PHOTO_ANALYSES_PER_DAY_INSTANCE=200

# Optional billing (Stripe): Free and Pro plans per workspace, paid by the owner. Billing is on only when both STRIPE_SECRET and
# STRIPE_PRICE_PRO_MONTHLY are set; without them every limit stays the one of the instance (config/inventories.php, config/workspaces.php).
# See "Billing (Stripe)" in the README for the Stripe setup. Keep the secret key here, never in the database.
# Restricted API key (rk_live_..., rk_test_... while testing) or secret key.
# STRIPE_SECRET=
# Signing secret (whsec_...) of the webhook endpoint https://<your domain>/webhooks/stripe. Optional: without it the webhook answers 404
# and subscriptions are only read by `inventaire:sync-billing` (hourly), which is enough behind a firewall or on a local instance.
# STRIPE_WEBHOOK_SECRET=
# The Prices (price_...) of the one Stripe Product "Pro": monthly is required, yearly is optional (no yearly choice without it).
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# The prices are VAT-included (TTC): create the Stripe Prices with tax_behavior=inclusive. STRIPE_AUTOMATIC_TAX has Stripe Tax compute the tax
# at Checkout: turn it on only once Stripe Tax is set up with an active registration, otherwise no tax is collected.
# STRIPE_AUTOMATIC_TAX=false
# What the terms of sale promise, and who does it: cancelling ("Cancel your contract") opens the Stripe customer portal on the cancellation, so
# turn cancellation ON in the portal (Settings > Billing > Customer portal) and choose "at the end of the billing period"; withdrawing
# ("Withdraw from the contract here", 14 days) ends the subscription at once and mails the administrators the refund to make BY HAND in the
# Stripe dashboard (nothing is refunded automatically); the confirmation (PDF terms attached), the cancellation receipt and the yearly
# renewal notice (`inventaire:send-renewal-notices`, daily) are mails of the application: keep a queue worker and the schedule running. Leave
# Stripe's own receipt and failed-payment mails ON in the dashboard (Settings > Customer emails): the application does not send those.
# Show the plans (pricing page, pricing section of the home page) and the terms of sale before anything can be bought: Pro is a disabled
# "Coming soon" button and checkout stays closed. Works without Stripe. Ignored once the instance sells.
# BILLING_PRICING_PREVIEW=false
# The seller named in the terms of sale (/terms). The instance sells only when billing is on AND every one of these is filled in but the
# capital; a missing one prints [à compléter] and the terms stay a working version. Also set https://<your domain>/terms as the terms of
# service URL in the Stripe dashboard (Settings > Public details), or Checkout refuses the terms box.
# LEGAL_NAME=
# LEGAL_FORM=
# LEGAL_CAPITAL=
# LEGAL_ADDRESS=
# LEGAL_REGISTRATION=
# LEGAL_VAT_NUMBER=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_MEDIATOR_NAME=
# LEGAL_MEDIATOR_ADDRESS=
# LEGAL_MEDIATOR_URL=
# What the page shows as the price of Pro, in the smallest unit of the currency (cents) and a lowercase ISO code. Display only: the amount
# charged is the one of the Stripe Price, keep the two in step.
# BILLING_CURRENCY=eur
# BILLING_PRO_MONTHLY_AMOUNT=600
# BILLING_PRO_YEARLY_AMOUNT=6000
# Limits of each plan, per workspace: inventories, items per inventory, storage (megabytes), members (invitations waiting included), share
# links per inventory, and whether the photo entry is included (it still needs the switch in Administration and the consent of the owner).
# BILLING_FREE_INVENTORIES=3
# BILLING_FREE_ITEMS=500
# BILLING_FREE_STORAGE_MB=200
# BILLING_FREE_MEMBERS=3
# BILLING_FREE_SHARE_LINKS=2
# BILLING_FREE_PHOTO_ENTRY=false
# BILLING_PRO_INVENTORIES=100
# BILLING_PRO_ITEMS=10000
# BILLING_PRO_STORAGE_MB=10240
# BILLING_PRO_MEMBERS=50
# BILLING_PRO_SHARE_LINKS=20
# BILLING_PRO_PHOTO_ENTRY=true

# The first administrator, created when the instance installs itself. There are no passwords:
# they sign in with a code emailed to this address, so it must be one they can read.
# ADMIN_NAME="Jane Doe"
# ADMIN_EMAIL=jane@example.com

# Application key. Leave it out: it is generated on the first start and kept in the
# storage volume. Set it only to restore an instance (php artisan key:generate --show).
# APP_KEY=

# -----------------------------------------------------------------------------
# Another database server: the DB_* variables below replace the bundled PostgreSQL
# (their defaults point at the `db` service of compose.yaml; to drop that service see
# "Another database server" in the README).
# -----------------------------------------------------------------------------
# pgsql, mysql or mariadb:
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=inventaire
# DB_USERNAME=inventaire

# Where settings live. APP_ENV (production), APP_DEBUG (false) and LOG_CHANNEL (stderr) are
# environment variables of the image: change them here, in this file, never in the
# configuration file the installer generates (/app/storage/.env), which a real environment
# variable always overrides. That generated file also must not have a sibling named
# `.env.production`: Laravel would load that one instead.
# APP_DEBUG=false
# LOG_CHANNEL=stderr
