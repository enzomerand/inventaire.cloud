          { "key": "appliance", "label": { "fr": "Électroménager", "en": "Appliances" }, "color": "blue" },
          { "key": "electronics", "label": { "fr": "High-tech", "en": "Electronics" }, "color": "indigo" },
          { "key": "decor", "label": { "fr": "Décoration", "en": "Decor" }, "color": "pink" },
          {
            "key": "clothing",
            "label": { "fr": "Linge et vêtements", "en": "Clothing and linens" },
            "color": "purple"
          },
          {
            "key": "tools",
            "label": { "fr": "Outillage et bricolage", "en": "Tools and DIY" },
            "color": "teal"
          },
          {
            "key": "valuables",
            "label": { "fr": "Bijoux et objets de valeur", "en": "Jewelry and valuables" },
            "color": "yellow"
          },
          { "key": "other", "label": { "fr": "Autre", "en": "Other" }, "color": "gray" }
        ]
      }
    },
    { "key": "brand_model", "type": "text", "name": { "fr": "Marque et modèle", "en": "Brand and model" } },
    {
      "key": "serial",
      "type": "barcode",
      "name": { "fr": "Numéro de série", "en": "Serial number" },
      "options": { "format": "any" }
    },
    { "key": "purchase_date", "type": "date", "name": { "fr": "Date d'achat", "en": "Purchase date" } },
    {
      "key": "price",
      "type": "money",
      "name": { "fr": "Prix d'achat", "en": "Purchase price" },
      "options": { "currency": "EUR" }
    },
    {
      "key": "value",
      "type": "money",
      "name": { "fr": "Valeur estimée", "en": "Estimated value" },
      "options": { "currency": "EUR" }
    },
    {
      "key": "condition",
      "type": "select",
      "name": { "fr": "État", "en": "Condition" },
      "options": {
        "choices": [
          { "key": "new", "label": { "fr": "Neuf", "en": "New" }, "color": "green" },
          { "key": "good", "label": { "fr": "Bon état", "en": "Good" }, "color": "teal" },
          { "key": "fair", "label": { "fr": "État moyen", "en": "Fair" }, "color": "yellow" },
          { "key": "worn", "label": { "fr": "Usé", "en": "Worn" }, "color": "red" }
        ]
      }
    },
    { "key": "warranty_end", "type": "date", "name": { "fr": "Fin de garantie", "en": "Warranty end" } },
    {
      "key": "photos",
      "type": "photo",
      "name": { "fr": "Photos", "en": "Photos" },
      "options": { "max_files": 3 }
    },
    {
      "key": "documents",
      "type": "file",
      "name": { "fr": "Factures et garanties", "en": "Invoices and warranties" },
      "options": { "max_files": 5 }
    }
  ],
